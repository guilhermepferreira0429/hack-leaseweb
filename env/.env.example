# Leaseweb Public Cloud
LSW_API_KEY=
LSW_API_BASE=https://api.leaseweb.com/publicCloud/v1
ADMIN_IP=
# Security groups (ids, separados por vírgula) em que a defesa pode mexer. Só o da vítima.
# Nunca o do isco (22 aberto de propósito) nem o do cérebro (SSH de administração). Vazio = não mexe em nada.
LSW_SG_GERIDOS=
# IP público -> security group ("ip=sg,ip=sg"). Opcional: sem isto vai-se à API (GET /instances).
# Só com este mapa a defesa liga uma porta vista pelo atacante à regra certa.
LSW_IP_SG=

# LLM compatível com OpenAI (TensorX ou sference, UE)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Fornecedor de reserva (opcional). Usa-se o primeiro disponível: se o 1.º faltar, falhar ou passar do timeout, tenta o 2.º.
LLM_BASE_URL_2=
LLM_API_KEY_2=
LLM_MODEL_2=
# Por tentativa. Se nenhum responder, usa-se um texto fixo por tipo de achado.
LLM_TIMEOUT_MS=20000

# Telegram: um bot por agente, um grupo "Direção"
TELEGRAM_TOKEN_CHEFE=
TELEGRAM_TOKEN_MIGRADOR=
TELEGRAM_TOKEN_ATACANTE=
TELEGRAM_TOKEN_DEFESA=
TELEGRAM_GRUPO_ID=
TELEGRAM_DONO_ID=
# Link de convite do grupo "Direção" (https://t.me/+...): mostra o QR no ecrã /isco para o júri entrar. Vazio = sem QR.
TELEGRAM_CONVITE_URL=
# IDs do Telegram (from.id) que podem aprovar e desfazer, separados por vírgula. Vazio = só TELEGRAM_DONO_ID.
TELEGRAM_APROVADORES=
# O atacante fala no grupo (só publica; não lê o grupo). Com sim, fala só em privado com o dono.
TELEGRAM_ATACANTE_PRIVADO=

# Atacante: só estes IPs podem ser alvo (separados por vírgula)
ALVOS_PERMITIDOS=
# Portas a não reportar no reconhecimento (separadas por vírgula). Ex.: 22 quando só está aberta aos nossos IPs.
ATACANTE_IGNORAR_PORTAS=
# Utilizador SSH deixado na VM da demo (ver detection-and-response.md). Vazio = deploy.
ATACANTE_SSH_UTILIZADOR=deploy
# Senha fraca da demo: só no .env, nunca no repositório. Vazia = usa apenas a wordlist do repositório.
ATACANTE_SENHA_DEMO=
# 1 = o /atacar corre também os extras de nível B (TLS, credenciais de fábrica, bucket) no fim.
ATACANTE_EXTRAS=
# Bucket a testar nos extras (leitura anónima?). Vazio = não testa. Porta por omissão 9000 (MinIO).
ATACANTE_BUCKET=
ATACANTE_BUCKET_PORTA=9000

# Relatório do incidente: nome amigável do servidor (ex.: "a base de dados da loja"). Vazio = o IP/instanceId da auditoria.
RELATORIO_NOME_SERVIDOR=

# Migrador
LOCALSTACK_ENDPOINT=http://127.0.0.1:4566
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Exemplo-app (Postgres a fazer de RDS, env/docker-compose.yml)
POSTGRES_PASSWORD=
DATABASE_URL=postgres://app:<senha>@127.0.0.1:5433/encomendas

# Isco
ISCO_HOST=
ISCO_SSH_USER=
# Os nossos IPs (separados por vírgula): os logins da equipa não contam como tentativas.
ISCO_IGNORAR_IPS=

PORT=3000
# Modo noite (defesa): sem resposta do dono em N minutos a uma falha crítica, deixa a porta só para estes IPs
# e fecha-a ao mundo (temporário, /desfazer repõe). Vazio = desligado.
MODO_NOITE_MINUTOS=
MODO_NOITE_IPS=
# Painel: só 127.0.0.1 por omissão (ver por túnel SSH). 0.0.0.0 só com o security group fechado ao nosso IP.
PAINEL_HOST=127.0.0.1
# Token do botão Desfazer no painel (ex.: openssl rand -hex 16). Vazio = botão desligado.
PAINEL_TOKEN=

# Exemplo-app: armazenamento e fila. Vazio = LocalStack (a "AWS"); o migrador (verificar) define-as
# ele próprio para correr os mesmos testes contra o LocalStack e depois contra o MinIO.
ARMAZENAMENTO_ENDPOINT=
ARMAZENAMENTO_BUCKET=
ARMAZENAMENTO_ACCESS_KEY=
ARMAZENAMENTO_SECRET_KEY=
FILA_URL=
FILA_NOME=

# Orquestrador: quanto tempo espera pelas decisões do dono antes de seguir (ms; por omissão 10 min).
ESPERA_DECISAO_MS=600000

# Certificado de migração: onde ficam os dados (ex.: "Leaseweb, Amesterdão (NL)"). Vazio = não se diz.
LOCAL_DADOS=

# Migrador nível B: Postgres de destino na Leaseweb (env/docker-compose.yml, postgres-destino)
POSTGRES_DESTINO_PASSWORD=
# Porta local (por omissão 5434); mudar só se estiver ocupada na máquina, e acertar o DATABASE_URL_DESTINO.
POSTGRES_DESTINO_PORTA=
DATABASE_URL_DESTINO=postgres://app:<senha>@127.0.0.1:5434/encomendas

# Decisor de destino: capacidade LIVRE da VM destino (free -h, nproc, df -h). Vazio = o decisor não fala.
VM_DESTINO_RAM_GB=
VM_DESTINO_VCPU=
VM_DESTINO_DISCO_GB=
# O dono já tem backups dos dados? sim | nao
DONO_TEM_BACKUPS=nao

# Migrador nível B: RabbitMQ, destino da fila SQS (env/docker-compose.yml). Nunca guest/guest.
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_URL=amqp://<utilizador>:<senha>@127.0.0.1:5672
# Exemplo-app: sqs (por omissão, LocalStack) ou rabbitmq (usa RABBITMQ_URL). O migrador (verificar) escolhe-o sozinho.
FILA_TIPO=

# ElastiCache (origem) e Valkey (destino), env/docker-compose.yml. Senhas diferentes, geradas (ex.: openssl rand -hex 16).
REDIS_ORIGEM_PASSWORD=
REDIS_ORIGEM_URL=redis://:<senha>@127.0.0.1:6380
VALKEY_PASSWORD=
VALKEY_URL=redis://:<senha>@127.0.0.1:6381

# OpenBao (destino dos segredos), env/docker-compose.yml. Token aleatório (ex.: openssl rand -hex 24).
OPENBAO_TOKEN=
OPENBAO_ADDR=http://127.0.0.1:8200

# Migrador de código: "real" abre o pull request; vazio = ensaio (o diff fica no cérebro, nada sai).
MIGRADOR_PR=
# Repositório público da app onde o PR é aberto, no formato dono/nome (ex.: guilhermepferreira0429/hack-leaseweb-exemplo-app).
MIGRADOR_PR_REPO=
# Token fine-grained do GitHub só para esse repositório: Contents e Pull requests em escrita. Nunca no git.
GITHUB_TOKEN_EXEMPLO=
