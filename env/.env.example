# Leaseweb Public Cloud
LSW_API_KEY=
LSW_API_BASE=https://api.leaseweb.com/publicCloud/v1
# Security groups (ids, separados por vírgula) em que a defesa pode mexer. Só o da vítima.
# Nunca o do isco (22 aberto de propósito) nem o do cérebro (SSH de administração). Vazio = não mexe em nada.
LSW_SG_GERIDOS=

# LLM compatível com OpenAI (TensorX ou sference, UE)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Fornecedor de reserva (opcional). Usa-se o primeiro disponível: se o 1.º faltar, falhar ou passar do timeout, tenta o 2.º.
LLM_BASE_URL_2=
LLM_API_KEY_2=
LLM_MODEL_2=
# Por tentativa. Se nenhum responder, usa-se um texto fixo por tipo de achado.
LLM_TIMEOUT_MS=20000

# Telegram: um bot por agente, um grupo "Direção"
TELEGRAM_TOKEN_CHEFE=
TELEGRAM_TOKEN_MIGRADOR=
TELEGRAM_TOKEN_ATACANTE=
TELEGRAM_TOKEN_DEFESA=
TELEGRAM_GRUPO_ID=
TELEGRAM_DONO_ID=

# Atacante: só estes IPs podem ser alvo (separados por vírgula)
ALVOS_PERMITIDOS=

# Migrador
LOCALSTACK_ENDPOINT=http://127.0.0.1:4566
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Exemplo-app (Postgres a fazer de RDS, env/docker-compose.yml)
POSTGRES_PASSWORD=
DATABASE_URL=postgres://app:<senha>@127.0.0.1:5433/encomendas

# Isco
ISCO_HOST=
ISCO_SSH_USER=
# Os nossos IPs (separados por vírgula): os logins da equipa não contam como tentativas.
ISCO_IGNORAR_IPS=

PORT=3000

# Exemplo-app: armazenamento e fila. Vazio = LocalStack (a "AWS"); o migrador (verificar) define-as
# ele próprio para correr os mesmos testes contra o LocalStack e depois contra o MinIO.
ARMAZENAMENTO_ENDPOINT=
ARMAZENAMENTO_BUCKET=
ARMAZENAMENTO_ACCESS_KEY=
ARMAZENAMENTO_SECRET_KEY=
FILA_URL=
FILA_NOME=
