{
  "//": "Conta AWS simulada para a demo do tradutor. As chaves no user_data são falsas: o id é o de EXEMPLO da documentação da AWS e a chave secreta é fictícia. Não dão acesso a nada.",
  "terraform": {
    "required_providers": {
      "aws": { "source": "hashicorp/aws" }
    }
  },
  "provider": {
    "aws": { "region": "eu-west-1" }
  },
  "variable": {
    "db_password": { "type": "string", "sensitive": true }
  },
  "data": {
    "aws_ami": {
      "ubuntu": {
        "most_recent": true,
        "owners": ["099720109477"],
        "filter": [
          { "name": "name", "values": ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"] }
        ]
      }
    }
  },
  "resource": {
    "aws_security_group": {
      "web": {
        "name": "encomendas-web",
        "description": "App das encomendas",
        "ingress": [
          { "description": "SSH", "from_port": 22, "to_port": 22, "protocol": "tcp", "cidr_blocks": ["0.0.0.0/0"] },
          { "description": "HTTP", "from_port": 80, "to_port": 80, "protocol": "tcp", "cidr_blocks": ["0.0.0.0/0"] },
          { "description": "HTTPS", "from_port": 443, "to_port": 443, "protocol": "tcp", "cidr_blocks": ["0.0.0.0/0"] },
          { "description": "Postgres", "from_port": 5432, "to_port": 5432, "protocol": "tcp", "cidr_blocks": ["0.0.0.0/0"] }
        ],
        "egress": [
          { "from_port": 0, "to_port": 0, "protocol": "-1", "cidr_blocks": ["0.0.0.0/0"] }
        ]
      }
    },
    "aws_instance": {
      "web": {
        "ami": "${data.aws_ami.ubuntu.id}",
        "instance_type": "m5.large",
        "availability_zone": "eu-west-1a",
        "vpc_security_group_ids": ["${aws_security_group.web.id}"],
        "key_name": "deploy",
        "root_block_device": { "volume_size": 30 },
        "user_data": "#!/bin/bash\napt-get update -y\napt-get install -y nodejs npm git\nexport AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE\nexport AWS_SECRET_ACCESS_KEY=FICTICIO-nao-e-uma-chave-real-0000000000\ngit clone https://example.com/encomendas.git /opt/app\ncd /opt/app && npm ci && npm start &\n",
        "tags": { "Name": "encomendas-web" }
      }
    },
    "aws_s3_bucket": {
      "ficheiros": { "bucket": "encomendas-ficheiros" }
    },
    "aws_sqs_queue": {
      "encomendas": { "name": "encomendas" }
    },
    "aws_db_instance": {
      "encomendas": {
        "engine": "postgres",
        "engine_version": "16",
        "instance_class": "db.t3.medium",
        "allocated_storage": 20,
        "db_name": "encomendas",
        "username": "app",
        "password": "${var.db_password}",
        "skip_final_snapshot": true
      }
    },
    "aws_iam_user": {
      "deploy": { "name": "deploy" }
    },
    "aws_lambda_function": {
      "miniaturas": {
        "function_name": "miniaturas",
        "runtime": "nodejs20.x",
        "handler": "index.handler",
        "filename": "miniaturas.zip",
        "role": "arn:aws:iam::123456789012:role/lambda-miniaturas"
      }
    }
  }
}
